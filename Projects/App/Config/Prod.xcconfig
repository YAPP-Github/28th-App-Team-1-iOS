#include? "Secrets.xcconfig"
#include "Version.xcconfig"

// 운영계 — Release Configuration 에 연결.
// 서버는 단일계라 Dev/QA/Prod 가 같은 호스트를 본다 — 계 구분은 APP_ENV·bundle ID 로만.
APP_ENV = prod
API_BASE_URL = https:/$()/hilit.my

// 카카오 Native 앱 키 — 운영계 Kakao 앱 (Secrets.xcconfig)
KAKAO_NATIVE_APP_KEY = $(KAKAO_NATIVE_APP_KEY_PROD)

// 운영계는 접미사 없음 → com.hilit.app
BUNDLE_ID_SUFFIX =
APP_DISPLAY_NAME = Hilit
