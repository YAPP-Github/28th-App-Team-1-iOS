// 로컬 전용 시크릿 템플릿. 이 파일을 Secrets.xcconfig 로 복사한 뒤 값을 채우세요.
// (Secrets.xcconfig 는 .gitignore 대상 — 실제 값은 절대 커밋하지 않습니다)
//
// 카카오 Native 앱 키 — 환경별로 다른 Kakao 앱을 쓸 수 있게 분리했다.
// 각 env xcconfig(Dev/QA/Prod)가 아래 값 중 자기 것을 KAKAO_NATIVE_APP_KEY 로 매핑한다.
// 콘솔: developers.kakao.com > 내 애플리케이션 > 앱 키 > Native 앱 키
// (모두 같은 Kakao 앱을 쓸 거면 세 값에 동일 키를 넣어도 된다.)
KAKAO_NATIVE_APP_KEY_DEV =
KAKAO_NATIVE_APP_KEY_QA =
KAKAO_NATIVE_APP_KEY_PROD =

// 실기기 빌드용 개인 서명 팀 ID (Xcode > Settings > Accounts 또는 developer.apple.com > Membership).
// 시뮬레이터만 쓰면 비워둬도 됩니다.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
